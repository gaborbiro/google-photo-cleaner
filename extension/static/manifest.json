{
  "manifest_version": 3,
  "name": "Photo Cleaner Connector",
  "description": "Read-only bridge between photos.google.com and the local Photo Cleaner desktop app.",
  "version": "0.3.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://photos.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Photo Cleaner Connector",
    "default_popup": "popup.html"
  }
}
