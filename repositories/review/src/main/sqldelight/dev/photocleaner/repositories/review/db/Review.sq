CREATE TABLE decision (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    group_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    undone_at INTEGER
);

CREATE TABLE decision_item (
    decision_id INTEGER NOT NULL,
    media_key TEXT NOT NULL,
    dedup_key TEXT NOT NULL,
    PRIMARY KEY (decision_id, media_key)
);

CREATE TABLE trash_job (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    decision_id INTEGER NOT NULL,
    media_key TEXT NOT NULL,
    dedup_key TEXT NOT NULL,
    state TEXT NOT NULL,
    attempts INTEGER NOT NULL,
    last_error TEXT,
    updated_at INTEGER NOT NULL
);

CREATE INDEX trash_job_state ON trash_job(state);

insertDecision:
INSERT INTO decision (group_id, kind, created_at) VALUES (?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

insertDecisionItem:
INSERT INTO decision_item (decision_id, media_key, dedup_key) VALUES (?, ?, ?);

insertJob:
INSERT INTO trash_job (decision_id, media_key, dedup_key, state, attempts, updated_at) VALUES (?, ?, ?, 'QUEUED', 0, ?);

selectActiveDecisions:
SELECT * FROM decision WHERE undone_at IS NULL ORDER BY id DESC;

selectDecision:
SELECT * FROM decision WHERE id = ?;

selectDecisionItems:
SELECT * FROM decision_item WHERE decision_id = ?;

markUndone:
UPDATE decision SET undone_at = ? WHERE id = ? AND undone_at IS NULL;

changes:
SELECT changes();

-- Undo: cancel what was never sent, ask to restore what was trashed.
cancelUnsentJobs:
UPDATE trash_job SET state = 'CANCELLED', updated_at = :at
WHERE decision_id = :decision AND state IN ('QUEUED', 'FAILED', 'BLOCKED');

requestRestore:
UPDATE trash_job SET state = 'RESTORE_REQUESTED', updated_at = :at
WHERE decision_id = :decision AND state = 'COMPLETED';

selectJobsInStates:
SELECT * FROM trash_job WHERE state IN ? ORDER BY id LIMIT ?;

transition:
UPDATE trash_job SET state = :to, last_error = :error, updated_at = :at,
    attempts = attempts + CASE WHEN :to = 'SENDING' THEN 1 ELSE 0 END
WHERE id = :id AND state = :from;

selectJobCounts:
SELECT state, count(*) AS n FROM trash_job GROUP BY state;
